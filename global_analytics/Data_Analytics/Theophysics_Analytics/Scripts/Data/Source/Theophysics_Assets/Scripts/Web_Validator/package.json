{
  "name": "theophysics-validator",
  "version": "1.0.0",
  "description": "Open source equation validator for the Theophysics framework. Deployed on Cloudflare Workers.",
  "main": "worker.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "d1:create": "wrangler d1 create theophysics-validator-db",
    "d1:init": "wrangler d1 execute theophysics-validator-db --file=d1-schema.sql",
    "d1:query": "wrangler d1 execute theophysics-validator-db --command",
    "test": "echo \"No tests yet\" && exit 0"
  },
  "keywords": [
    "theophysics",
    "physics",
    "theology",
    "consciousness",
    "quantum-mechanics",
    "cloudflare-workers",
    "equation-validator",
    "open-source"
  ],
  "author": "David Lowe",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/davidlowe/theophysics-validator.git"
  },
  "devDependencies": {
    "wrangler": "^3.78.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
